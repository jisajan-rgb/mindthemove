# Copy to .env.local for local development.
# Runtime pages degrade with a configuration message if these are missing.
# `npm run build` can succeed without live credentials (Prisma generate + dynamic routes).

# ---------------------------------------------------------------------------
# Supabase Postgres (Prisma)
# Use the pooled URI for the app. For `prisma migrate`, prefer the direct
# (non-pooler) connection string on port 5432 if pooler migrate fails.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---------------------------------------------------------------------------
# Supabase Auth (browser-safe — these are the only public keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: used only by `npm run prisma:seed` to attach an existing Auth user
# as a Mind the Move ops admin. Create the user in the Supabase Auth dashboard
# first, then paste the UUID and email here. Never commit real values.
ADMIN_USER_ID=""
ADMIN_EMAIL=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MoveType {
  BUYING
  SELLING
  BOTH
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

model Business {
  id            String         @id @default(cuid())
  name          String
  email         String
  phone         String?
  website       String?
  service       String
  coverageArea  String
  description   String?
  status        BusinessStatus @default(PENDING)
  qualityScore  Int            @default(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leads         Lead[]
}

model Lead {
  id             String    @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  postcode       String
  moveType       MoveType
  serviceNeeded  String
  propertyValue  String?
  timeline       String?
  notes          String?
  matchedBusinessId String?
  matchedBusiness   Business? @relation(fields: [matchedBusinessId], references: [id])
  createdAt      DateTime  @default(now())
}

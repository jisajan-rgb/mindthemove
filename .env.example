# MindTheMove environment variables (for upcoming API/DB features)
# Copy to .env.local for local development.

# Public
NEXT_PUBLIC_APP_NAME=MindTheMove
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future backend integrations (leave blank for now)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mindthemove?schema=public
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=

# ClickUp automation
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
CLICKUP_LIST_ID=
CLICKUP_DEFAULT_ASSIGNEE_ID=

# Admin protection for /admin and /api/admin/*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
